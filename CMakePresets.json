{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "frontend",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/frontend",
      "cacheVariables": {
        "BUILD_TESTING": false,
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/release/VectorNetworkAnalyzer",
        "VNA_BUILD_BACKEND": false,
        "VNA_BUILD_FRONTEND": true
      }
    },
    {
      "name": "backend",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/backend",
      "cacheVariables": {
        "BUILD_TESTING": false,
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/release/VectorNetworkAnalyzer",
        "VNA_BUILD_BACKEND": true,
        "VNA_BUILD_FRONTEND": false
      }
    },
    {
      "name": "test",
      "displayName": "Complete debug test build",
      "description": "Build and run every test with ccache and reduced debug information",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/test",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g1",
        "VNA_BUILD_BACKEND": true,
        "VNA_BUILD_FRONTEND": false
      }
    },
    {
      "name": "release",
      "displayName": "Portable release packaging",
      "description": "Configure the explicit portable release packaging target",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/release-driver",
      "cacheVariables": {
        "BUILD_TESTING": false,
        "CMAKE_BUILD_TYPE": "Release",
        "VNA_BUILD_BACKEND": true,
        "VNA_BUILD_FRONTEND": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "frontend",
      "configurePreset": "frontend",
      "jobs": 8,
      "targets": [
        "install"
      ]
    },
    {
      "name": "backend",
      "configurePreset": "backend",
      "jobs": 8,
      "targets": [
        "install"
      ]
    },
    {
      "name": "test",
      "displayName": "Build complete test suite",
      "configurePreset": "test",
      "jobs": 8
    },
    {
      "name": "release",
      "displayName": "Build portable release",
      "configurePreset": "release",
      "jobs": 8,
      "targets": [
        "package-release"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "displayName": "Run complete test suite",
      "configurePreset": "test",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8,
        "noTestsAction": "error"
      }
    }
  ]
}
